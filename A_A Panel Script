-- 🔄 وظيفة السبام
-- ═══════════════════════════════════════════════════════════════════════

local function SendChatMessage(msg)
    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
            if channel then
                channel:SendAsync(msg)
            end
        else
            local chatEvents = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
            if chatEvents then
                local sayEvent = chatEvents:FindFirstChild("SayMessageRequest")
                if sayEvent then
                    sayEvent:FireServer(msg, "All")
                end
            end
        end
    end)
end

SpamToggleBtn.MouseButton1Click:Connect(function()
    if SpamActive then
        SpamActive = false
        SpamToggleBtn.Text = "بدء التشغيل"
        SpamToggleBtn.BackgroundColor3 = Colors.Accent
    else
        local text = SpamTextBox.Text
        if text == "" then return end
        local delay = tonumber(DelayBox.Text) or 0.5
        if delay < 0.1 then delay = 0.1 end
        
        SpamActive = true
        SpamToggleBtn.Text = "إيقاف"
        SpamToggleBtn.BackgroundColor3 = Colors.Red
        
        SpamThread = task.spawn(function()
            while SpamActive do
                SendChatMessage(text)
                task.wait(delay)
            end
        end)
    end
end)

