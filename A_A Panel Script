    if SpamActive then
        SpamActive = false
        SpamToggleBtn.Text = "بدء التشغيل"
        SpamToggleBtn.BackgroundColor3 = Colors.Accent
    end
    StatusLabel.Text = "⏹️ تم الإيقاف"
end)

